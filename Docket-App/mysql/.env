# MySQL local settings - read automatically by docker compose
MYSQL_VERSION=8.4
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=default_database
MYSQL_PORT=3306
# 127.0.0.1 = only this computer can connect. Use 0.0.0.0 to allow other machines on your LAN.
BIND_ADDRESS=127.0.0.1
TZ=UTC
# InnoDB buffer pool (main cache). 1G is fine for most laptops; raise for big datasets.
MYSQL_BUFFER_POOL=1G
