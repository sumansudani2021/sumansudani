# MongoDB local settings - read automatically by docker compose
MONGO_VERSION=8.0
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=root
MONGO_DATABASE=default_database
MONGO_PORT=27017
# WiredTiger cache in GB. 1 is fine for most laptops; raise for big datasets.
MONGO_CACHE_GB=1
# 127.0.0.1 = only this computer can connect. Use 0.0.0.0 to allow other machines on your LAN.
BIND_ADDRESS=127.0.0.1
TZ=UTC
