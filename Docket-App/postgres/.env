# PostgreSQL local settings - read automatically by docker compose
POSTGRES_VERSION=18
POSTGRES_USER=root
POSTGRES_PASSWORD=root
POSTGRES_DB=default_database
POSTGRES_PORT=5432
# Main cache. 512MB is fine for most laptops; raise for big datasets.
POSTGRES_SHARED_BUFFERS=512MB
# 127.0.0.1 = only this computer can connect. Use 0.0.0.0 to allow other machines on your LAN.
BIND_ADDRESS=127.0.0.1
TZ=UTC
